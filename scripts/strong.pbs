#!/bin/bash
#PBS -N matmul_strong
#PBS -q par128
#PBS -l select=1:ncpus=128:mpiprocs=128
#PBS -l walltime=02:00:00
#PBS -j oe

# Experiment 2: strong scaling (fixed N, P = 1 ... 128), plus the serial blocked time as a
# second T(1). Use the best b from blocks.pbs, e.g.
#   qsub -v BLOCK_MPI=128,BLOCK_BLAS=6000 scripts/strong.pbs

cd "${PBS_O_WORKDIR:-.}"
source scripts/common.sh

NS=${NS:-"2000 6000"}
PS=${PS:-"1 2 4 8 16 32 64 128"}
BLOCK_MPI=${BLOCK_MPI:-64}
BLOCK_BLAS=${BLOCK_BLAS:-64}
REPS=${REPS:-5}

start_csv strong
for N in $NS; do
	run 1 --mode serial --kernel blocked --n "$N" --block "$BLOCK_MPI" --reps "$REPS"
	for P in $PS; do
		run "$P" --mode mpi --n "$N" --block "$BLOCK_MPI" --reps "$REPS"
		run "$P" --mode mpi_blas --n "$N" --block "$BLOCK_BLAS" --reps "$REPS"
	done
done
