#!/bin/bash
#PBS -N matmul_strong
#PBS -q par128
#PBS -l select=1:ncpus=128:mpiprocs=128
#PBS -l walltime=02:00:00
#PBS -j oe

# Experiment 2: strong scaling (fixed N, P = 1 ... 128), plus the serial blocked time as a
# second T(1). Block sizes are lists, so this job does not have to wait for blocks.pbs:
# mpi runs with b = 64 and 128 (the L2 range of the EPYC 7662), mpi_blas with one sgemm per rank
# (any b >= N). Override with qsub -v, e.g. qsub -v BLOCKS_MPI="128",BLOCKS_BLAS="512" scripts/strong.pbs

cd "${PBS_O_WORKDIR:-.}"
source scripts/common.sh

NS=${NS:-"2000 6000"}
PS=${PS:-"1 2 4 8 16 32 64 128"}
BLOCKS_MPI=${BLOCKS_MPI:-"64 128"}
BLOCKS_BLAS=${BLOCKS_BLAS:-"20000"}
REPS=${REPS:-5}

start_csv strong
for N in $NS; do
	for B in $BLOCKS_MPI; do
		run 1 --mode serial --kernel blocked --n "$N" --block "$B" --reps "$REPS"
	done
	for P in $PS; do
		for B in $BLOCKS_MPI; do
			run "$P" --mode mpi --n "$N" --block "$B" --reps "$REPS"
		done
		for B in $BLOCKS_BLAS; do
			run "$P" --mode mpi_blas --n "$N" --block "$B" --reps "$REPS"
		done
	done
done
